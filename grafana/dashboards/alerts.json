{
  "title": "Alerts",
  "uid": "network-alerts",
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Active Alerts",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "orange", "value": null }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT started_at AS time, device_id, COALESCE(interface_name, '-') AS interface, alert_type, severity, metric_value, threshold, status FROM alerts WHERE status = 'ACTIVE' ORDER BY started_at DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Alert History (last 6h)",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT started_at, resolved_at, device_id, COALESCE(interface_name, '-') AS interface, alert_type, severity, metric_value, threshold, status FROM alerts WHERE started_at > NOW() - INTERVAL '6 hours' ORDER BY started_at DESC",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active Alerts by Type",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT alert_type AS metric, COUNT(*) AS value FROM alerts WHERE status = 'ACTIVE' GROUP BY alert_type",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Active Alerts by Severity",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT severity AS metric, COUNT(*) AS value FROM alerts WHERE status = 'ACTIVE' GROUP BY severity",
          "refId": "A"
        }
      ]
    }
  ]
}
