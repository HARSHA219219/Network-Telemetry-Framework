{
  "title": "Network Overview",
  "uid": "network-overview",
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Total Devices",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "targets": [
        { "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM devices", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Devices Online",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] },
      "targets": [
        { "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM devices WHERE reachable = true", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Devices Offline",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM devices WHERE reachable = false", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 1 }
      ] } }, "overrides": [] },
      "targets": [
        { "format": "table", "rawSql": "SELECT COUNT(*) AS value FROM alerts WHERE status = 'ACTIVE'", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "title": "Current Network Load (avg utilization %, last 5 min)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "red", "value": 80 }
      ] } }, "overrides": [] },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT AVG(metric_value) AS value FROM telemetry_metrics WHERE metric_type IN ('utilization_in','utilization_out') AND timestamp > NOW() - INTERVAL '5 minutes'",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Devices",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "postgres", "uid": "postgres-telemetry" },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT device_id, device_ip, kind, reachable, last_seen FROM devices ORDER BY device_id",
          "refId": "A"
        }
      ]
    }
  ]
}
